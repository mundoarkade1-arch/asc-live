<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/asc_bg</item>
        <item name="android:colorBackground">@color/asc_bg</item>
        <item name="android:colorAccent">@color/asc_accent</item>
        <item name="android:colorPrimary">@color/asc_bg</item>
        <item name="android:textColorPrimary">@color/asc_white</item>
        <item name="android:windowAnimationStyle">@style/ScreenAnim</item>
    </style>

    <!-- Transição curta entre telas (só transparência: leve). -->
    <style name="ScreenAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
    </style>
</resources>
