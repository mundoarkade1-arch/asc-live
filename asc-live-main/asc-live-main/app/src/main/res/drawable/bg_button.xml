<?xml version="1.0" encoding="utf-8"?>
<!-- Botões dos teclados (senha e busca): escuro, e no foco ganha contorno limão. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A6B60" />
            <stroke android:width="3dp" android:color="#F20B0B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A6B60" />
            <stroke android:width="3dp" android:color="#F20B0B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#5A6B60" />
            <stroke android:width="3dp" android:color="#F20B0B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3F4C44" />
            <stroke android:width="1dp" android:color="#65746A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
